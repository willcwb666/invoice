# Exemplo de Variaveis de Ambiente para o Vercel e Supabase

# String de conexao pooler do Supabase (porta 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# String de conexao direta (porta 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Supabase Public API
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON_OR_PUBLISHABLE_KEY]"

# Resend API Key
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="Renata Matos <onboarding@resend.dev>"

# Sincronizacao do Calendario iCloud (opcional)
# URL publica do "Calendario Publico" do iPhone (webcal://...). Se nao definida,
# a URL pode ser configurada manualmente na tela de Configuracoes em vez de via env.
ICLOUD_CALENDAR_URL=""
# Segredo usado para autorizar a assinatura (sem login) do feed .ics de saida
# em /api/v1/agenda/feed.ics?token=... — gere um valor aleatorio unico por
# instalacao (nunca reaproveite o exemplo, nunca hardcode no codigo-fonte).
WEBCAL_SECRET=""
