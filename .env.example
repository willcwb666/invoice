# Exemplo de Variaveis de Ambiente para o Vercel
# (o SDK do Supabase nao e mais usado - o Postgres pode continuar hospedado
# la, mas apenas via DATABASE_URL/DIRECT_URL abaixo)

# String de conexao pooler do Supabase (porta 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# String de conexao direta (porta 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Resend API Key
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="Renata Matos <onboarding@resend.dev>"

# Autenticacao (obrigatorio) — segredo usado para assinar (HMAC-SHA256) os
# tokens de sessao de login. Sem essa variavel o login/registro falha com
# erro 500. Gere um valor unico por instalacao, por exemplo com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=""

# URL publica canonica do deploy (obrigatorio em producao). Usada pelo Better
# Auth para montar callbacks/baseURL e pelos links enviados por e-mail
# (orcamentos, faturas, recuperacao de carrinho). Sem essa variavel, em
# producao ela cai no default "http://localhost:3000" e todo link de e-mail
# para o cliente fica quebrado. No Vercel, defina como a URL publica do
# projeto, ex: "https://seu-dominio.vercel.app"
NEXT_PUBLIC_APP_URL=""

# Opcional - so necessario se BETTER_AUTH_URL precisar ser diferente de
# NEXT_PUBLIC_APP_URL (ex: um dominio interno distinto do publico).
# BETTER_AUTH_URL=""

# Opcional - so necessario se BETTER_AUTH_SECRET precisar ser diferente de
# SESSION_SECRET (o Better Auth usa SESSION_SECRET como fallback).
# BETTER_AUTH_SECRET=""

# Login com Google via Better Auth (opcional). Sem essas duas variaveis, o
# botao "Entrar com Google" fica inativo e so o login por e-mail/senha
# funciona.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Senha inicial da conta administradora provisionada automaticamente no
# primeiro start do servidor. Se nao definida, uma senha aleatoria e gerada
# e impressa uma unica vez nos logs do servidor.
ADMIN_INITIAL_PASSWORD=""

# Sincronizacao do Calendario iCloud (opcional)
# URL publica do "Calendario Publico" do iPhone (webcal://...). Se nao definida,
# a URL pode ser configurada manualmente na tela de Configuracoes em vez de via env.
ICLOUD_CALENDAR_URL=""
# Segredo usado para autorizar a assinatura (sem login) do feed .ics de saida
# em /api/v1/agenda/feed.ics?token=... — gere um valor aleatorio unico por
# instalacao (nunca reaproveite o exemplo, nunca hardcode no codigo-fonte).
WEBCAL_SECRET=""

# Parser inteligente de servicos incomuns/pedidos especiais em orcamentos
# (opcional). Sem essa variavel, o parser cai automaticamente no analisador
# local (sem IA) — nao ha erro nem funcionalidade quebrada, so fica menos
# preciso para textos incomuns.
GEMINI_API_KEY=""
# GOOGLE_API_KEY="" # alternativa a GEMINI_API_KEY, mesmo efeito

# Notificacoes Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@renatamatoscleaning.com"

# Segredo para protecao do endpoint de cron (despacho de push e briefing matinal)
CRON_SECRET=""

