generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
  FINANCIAL
  VIEWER
  CLEANER
}

enum UserStatus {
  PENDING_ONBOARDING
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

enum BillingType {
  CONSOLIDATED_MONTHLY
  PER_JOB
}

enum AppointmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AppointmentOrigin {
  INTERNAL
  ICLOUD_SYNC
  PUBLIC_BOOKING
}

enum ServiceType {
  STANDARD
  EXTRA
}

enum EstimateStatus {
  DRAFT
  PENDING
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum ExpenseCategory {
  FUEL
  CLEANING_SUPPLIES
  VEHICLE_MAINTENANCE
  EQUIPMENT
  MEALS
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  LOGIN
  CONVERT
}

model CompanyProfile {
  id                 String           @id @default(uuid())
  name               String
  tradeName          String?
  email              String
  phone              String
  monthlyRevenueGoal Decimal          @default(6000.00) @db.Decimal(10, 2)
  paymentMethods     String
  terms              String           @default("Payment is due within 7 days of invoice date. Late payments are subject to a 1.5% monthly finance charge.")
  signatureUrl       String?
  logoUrl            String?
  bookingSlug        String?          @unique
  icloudCalendarUrl  String?
  // Quantos dias a partir de hoje o sync do iCloud deve olhar pra frente.
  // Dias passados nunca são reprocessados (a agenda não é mexida de hoje pra trás).
  icloudSyncWindowDays Int            @default(60)
  lastICloudSyncAt   DateTime?
  // DB-row lock claimed atomically at sync start, cleared at sync end (see
  // claimIcloudSyncLock in lib/calendar/icloud.ts). Needed because every
  // in-memory lock in this file (companySyncLocks Map, activeSyncPromise,
  // lastSyncTimestamp) only protects against concurrency *within one
  // serverless instance* - Vercel can run instrumentation.ts's auto-sync on
  // a cold start at the same moment a user clicks "Sincronizar Agora" on a
  // different instance, and neither instance's in-memory state knows about
  // the other. That caused real unique-constraint failures
  // (appointments_companyId_externalEventId_key) when both instances' sync
  // runs raced the same calendar event's findUnique-then-upsert. A stale
  // lock (crash mid-sync) self-clears after icloudSyncLockStaleMinutes.
  icloudSyncLockedAt DateTime?
  // Admin-editable override of DEFAULT_ROLE_PERMISSIONS (see lib/security/rbac.ts).
  // Null means "use the defaults". Stored here (a singleton row) rather than
  // in an in-memory variable, which does not survive a server restart/redeploy
  // and is not shared across serverless instances.
  rolePermissions    Json?

  // Recuperação de Orçamentos Abandonados
  abandonedRecoveryEnabled      Boolean          @default(true)
  abandonedRecoveryMinutes      Int              @default(30)
  abandonedRecoveryDiscount     Decimal          @default(10.00) @db.Decimal(5, 2)
  abandonedRecoveryDiscountType String           @default("PERCENTAGE") // "PERCENTAGE" ou "FIXED"
  abandonedRecoverySubject      String           @default("Oferta especial para a limpeza da sua casa! ✨")
  abandonedRecoveryBody         String           @default("Olá [cliente]!\n\nVimos que você calculou o orçamento para a limpeza da sua casa no valor de $[valor].\n\nPara ajudar você a fechar conosco hoje, liberamos um desconto exclusivo de [desconto]!\n\nSeu valor especial com desconto fica por apenas $[valor_final].\n\nClique no botão abaixo para garantir sua vaga e agendar seu atendimento.")

  // Parâmetros de Rota & Agendamento
  workDayStartHour              String           @default("08:00")
  workDayEndHour                String           @default("18:00")
  workDays                      String           @default("MON,TUE,WED,THU,FRI")
  travelBufferMinutes           Int              @default(10)
  defaultStandardDurationMinutes Int             @default(120)
  defaultDeepDurationMinutes    Int              @default(300)
  recurrenceHorizonMonths       Int              @default(2)
  googleReviewUrl               String?
  lastCronDispatchAt            DateTime?

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  addresses          CompanyAddress[]
  users              User[]
  clients            Client[]
  services           Service[]
  appointments       Appointment[]
  invoices           Invoice[]
  estimates          Estimate[]
  expenses           Expense[]
  professionals      Professional[]
  notifications      Notification[]
  pushSubscriptions  PushSubscription[]
  scheduledPushes    ScheduledPush[]

  @@map("company_profiles")
}

model CompanyAddress {
  id        String         @id @default(uuid())
  companyId String
  company   CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  label     String         // Ex: "Evans (Atual)" ou "Greeley (Anterior)"
  street    String         // "4172 MeadowView" ou "1705 30th St., #104"
  city      String         // "Evans" ou "Greeley"
  state     String         @default("CO")
  zipCode   String         // "80620" ou "80631"
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([companyId])
  @@map("company_addresses")
}

model User {
  id                  String          @id @default(uuid())
  email               String          @unique
  name                String?
  image               String?
  phone               String?
  passwordHash        String?
  gender              String?         @default("FEMALE") // "MALE" | "FEMALE"
  role                Role            @default(OPERATOR)
  status              UserStatus      @default(PENDING_APPROVAL)
  isSuperAdmin        Boolean         @default(false)
  emailVerified       Boolean         @default(false)
  verificationToken   String?
  verificationExpires DateTime?
  companyId           String?
  company             CompanyProfile? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  professionalId      String?
  professional        Professional?   @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  sessions            Session[]
  accounts            Account[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  pushSubscriptions   PushSubscription[]

  @@index([companyId])
  @@index([status])
  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Client {
  id          String         @id @default(uuid())
  companyId   String
  company     CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  address     String         // Endereço completo para rota no Maps
  city        String?
  state       String?        @default("CO")
  zipCode     String?
  bedrooms    Int?
  bathrooms   Float?
  squareFeet  Int?
  propertyType String?
  billingType BillingType    @default(PER_JOB)
  entryCode   String?        // Código do portão, porta ou lockbox
  alarmCode   String?        // Instruções de armar/desarmar alarme
  pets        String?        // Informações sobre cães, gatos ou animais
  parkingInstructions String? // Onde estacionar (garagem, rua, etc.)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  appointments Appointment[]
  invoices     Invoice[]
  estimates    Estimate[]

  @@index([companyId])
  @@map("clients")
}

model Service {
  id                     String               @id @default(uuid())
  companyId              String
  company                CompanyProfile       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                   String               // "Office - Standard cleaning", etc.
  description            String?
  type                   ServiceType          @default(STANDARD)
  basePrice              Decimal              @db.Decimal(10, 2)
  defaultDurationMinutes Int                  @default(120)
  availableInEstimates   Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  appointmentServices    AppointmentService[]
  estimateItems          EstimateItem[]

  @@index([companyId])
  @@map("services")
}

model Appointment {
  id              String               @id @default(uuid())
  companyId       String
  company         CompanyProfile       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  title           String
  date            DateTime             // Data do atendimento
  startTime       DateTime
  endTime         DateTime
  location        String?              // Endereço do trabalho
  price           Decimal              @db.Decimal(10, 2)
  status          AppointmentStatus    @default(SCHEDULED)
  origin          AppointmentOrigin    @default(INTERNAL)
  externalEventId String?              // ID do evento no iCloud Calendar
  // Uma vez editado manualmente na aplicação, o próximo sync do iCloud não
  // pode mais sobrescrever os dados (senão a edição do usuário se perderia
  // no próximo carregamento de página, que já dispara sync automaticamente).
  manuallyEdited  Boolean              @default(false)
  invoiced        Boolean              @default(false)
  invoiceId       String?
  invoice         Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  // Não Faturável: quando false, este atendimento nunca entra em nenhum
  // cálculo financeiro (meta mensal, gráfico de receita, tela de Pagamentos)
  // mesmo tendo um valor preenchido - útil para eventos sincronizados do
  // iCloud que não são trabalhos pagos (compromisso pessoal, cortesia etc).
  billable        Boolean              @default(true)
  // Pagamento direto do atendimento (cliente que paga por limpeza, quinzenal
  // ou no fim do mês, sem fatura formal). Só tem sentido quando invoiced=false
  // - um atendimento já faturado usa o status da Invoice como fonte única
  // de verdade, nunca os dois ao mesmo tempo.
  paid            Boolean              @default(false)
  paidAt          DateTime?
  paymentMethod   String?
  notes           String?
  estimateId      String?
  estimate        Estimate?            @relation(fields: [estimateId], references: [id], onDelete: SetNull)

  // Recorrência Nativa (Séries de agendamento: Semanal, Bi-semanal, 3 Semanas, Mensal)
  recurrenceRule  String?              // "NONE" | "WEEKLY" | "BIWEEKLY" | "EVERY_3_WEEKS" | "MONTHLY"
  seriesId        String?              // UUID para agrupar agendamentos da mesma série recorrente
  recurrenceIndex Int?                 // 0, 1, 2... índice da ocorrência na série

  // Acesso Estruturado ao Imóvel
  entryCode           String?
  alarmCode           String?
  pets                String?
  parkingInstructions String?

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  services        AppointmentService[]
  professionals   AppointmentProfessional[]
  scheduledPushes ScheduledPush[]
  checklists      AppointmentChecklist[]
  photos          AppointmentPhoto[]

  // Prevents two concurrent iCloud syncs (manual + auto, or two tabs) from
  // both creating an appointment for the same calendar occurrence before
  // either can see the other's write. Paired with the per-company sync
  // lock in lib/calendar/icloud.ts, which closes the race at the
  // application level too. externalEventId is null for INTERNAL/manually
  // created appointments, and Postgres unique indexes allow any number of
  // NULLs, so this only constrains ICLOUD_SYNC rows.
  @@unique([companyId, externalEventId])
  @@index([companyId])
  @@index([clientId])
  @@index([date])
  @@index([status])
  @@index([billable])
  @@index([paid])
  @@index([seriesId])
  @@index([companyId, invoiced, billable, status])
  @@index([companyId, date])
  @@index([companyId, endTime])
  @@index([estimateId])
  @@map("appointments")
}

// Serviços selecionados num agendamento (many-to-many): permite somar o preço
// de múltiplos serviços (ex: Standard Cleaning + Fridge Cleaning) num só
// atendimento. `price` grava o basePrice do Service no momento do agendamento,
// para não alterar retroativamente o histórico se o preço do serviço mudar depois.
model AppointmentService {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  price         Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())

  @@unique([appointmentId, serviceId])
  @@index([appointmentId])
  @@index([serviceId])
  @@map("appointment_services")
}

model Estimate {
  id                       String         @id @default(uuid())
  companyId                String
  company                  CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId                 String
  client                   Client         @relation(fields: [clientId], references: [id], onDelete: Restrict)
  estimateNumber           String         @unique // Ex: "EST-01-2026"
  publicToken              String?        @unique // Token para acesso público do cliente
  status                   EstimateStatus @default(DRAFT)
  issueDate                DateTime       @default(now())
  validUntil               DateTime
  providerAddress          String         // Snapshot do endereço
  subtotal                 Decimal        @db.Decimal(10, 2)
  discount                 Decimal        @default(0) @db.Decimal(10, 2)
  tax                      Decimal        @default(0) @db.Decimal(10, 2)
  totalAmount              Decimal        @db.Decimal(10, 2)
  estimatedDurationMinutes Int?           // Duração calculada em minutos para agendamento
  abandonedEmailSentAt     DateTime?      // Data/hora que o e-mail de recuperação de abandono foi disparado
  abandonedDiscountApplied Boolean        @default(false)
  notes                    String?
  metadata                 Json?
  convertedInvoiceId       String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  items                    EstimateItem[]
  appointments             Appointment[]

  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@map("estimates")
}

model EstimateItem {
  id          String   @id @default(uuid())
  estimateId  String
  estimate    Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  total       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([estimateId])
  @@map("estimate_items")
}

model Invoice {
  id              String        @id @default(uuid())
  companyId       String
  company         CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  invoiceNumber   String        @unique // Ex: "08 - 2026"
  status          InvoiceStatus @default(PENDING)
  issueDate       DateTime      @default(now())
  dueDate         DateTime
  providerAddress String        // Snapshot do endereço (Greeley ou Evans)
  subtotal        Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  tax             Decimal       @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal       @db.Decimal(10, 2)
  paidAmount      Decimal       @default(0) @db.Decimal(10, 2)
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           InvoiceItem[]
  appointments    Appointment[]

  @@index([companyId])
  @@index([companyId, issueDate])
  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String    @id @default(uuid())
  invoiceId   String
  invoice     Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceDate DateTime? // Ex: 07/04/2026
  description String
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(10, 2)
  total       Decimal   @db.Decimal(10, 2)
  createdAt   DateTime  @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

model Expense {
  id          String          @id @default(uuid())
  companyId   String
  company     CompanyProfile  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime        @default(now())
  recurrence  String?         @default("ONE_TIME") // ONE_TIME, WEEKLY, BI_WEEKLY, MONTHLY
  receiptUrl  String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([companyId])
  @@index([category])
  @@index([date])
  @@map("expenses")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    AuditAction
  entity    String      // "Invoice", "Client", "Appointment", "Expense", "User"
  entityId  String?
  details   String?     // Detalhes em JSON da alteração
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model Professional {
  id              String                          @id @default(uuid())
  companyId       String
  company         CompanyProfile                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  role            String                          @default("Especialista de Limpeza")
  roleTitle       String?
  email           String?
  phone           String?
  color           String                          @default("indigo")
  isOwner         Boolean                         @default(false)
  active          Boolean                         @default(true)
  notes           String?
  commissions     Json                            // { STANDARD: { mode: "PERCENTAGE", value: 50 }, ... }
  commissionRules Json                            // { STANDARD: { category: "STANDARD", label: "...", mode: "PERCENTAGE", value: 50 }, ... }
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt

  history         ProfessionalCommissionHistory[]
  appointments    AppointmentProfessional[]
  users           User[]
  pushSubscriptions PushSubscription[]
  scheduledPushes ScheduledPush[]

  @@index([companyId])
  @@index([companyId, active])
  @@map("professionals")
}

model ProfessionalCommissionHistory {
  id             String       @id @default(uuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  effectiveFrom  String       // "YYYY-MM-DD" no fuso Mountain Time
  commissions    Json         // Snapshot das regras de comissão válidas a partir de effectiveFrom
  note           String?
  createdAt      DateTime     @default(now())

  @@index([professionalId])
  @@index([professionalId, effectiveFrom])
  @@map("professional_commission_histories")
}

model AppointmentProfessional {
  id               String       @id @default(uuid())
  appointmentId    String
  appointment      Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  professionalId   String
  professional     Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  cleaningCategory String?      // STANDARD, DEEP, MOVE_IN_OUT, CUSTOM
  createdAt        DateTime     @default(now())

  @@unique([appointmentId, professionalId])
  @@index([appointmentId])
  @@index([professionalId])
  @@map("appointment_professionals")
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  URGENT
}

model Notification {
  id             String           @id @default(uuid())
  companyId      String
  company        CompanyProfile   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  professionalId String?
  title          String
  message        String
  type           NotificationType @default(INFO)
  read           Boolean          @default(false)
  link           String?
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([companyId])
  @@index([userId])
  @@index([professionalId])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}


enum PushNotificationType {
  MORNING_BRIEF
  AGENDA_CHANGE
  DEPARTURE_REMINDER
  GENERAL
}

model PushSubscription {
  id             String         @id @default(uuid())
  companyId      String
  company        CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional?  @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  endpoint       String         @unique
  p256dh         String
  auth           String
  userAgent      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([professionalId])
  @@map("push_subscriptions")
}

model ScheduledPush {
  id             String               @id @default(uuid())
  companyId      String
  company        CompanyProfile       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  professionalId String?
  professional   Professional?        @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  appointmentId  String?
  appointment    Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  type           PushNotificationType
  title          String
  body           String
  url            String?              @default("/agenda")
  scheduledFor   DateTime
  sent           Boolean              @default(false)
  sentAt         DateTime?
  createdAt      DateTime             @default(now())

  @@index([companyId])
  @@index([scheduledFor, sent])
  @@index([appointmentId])
  @@map("scheduled_pushes")
}

model AppointmentChecklist {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  room          String      // "KITCHEN", "BATHROOMS", "BEDROOMS", "LIVING_ROOM", "GENERAL", "CUSTOM"
  task          String      // Ex: "Limpar fogão e bancadas"
  completed     Boolean     @default(false)
  completedAt   DateTime?
  completedBy   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([appointmentId])
  @@map("appointment_checklists")
}

model AppointmentPhoto {
  id            String      @id @default(uuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  photoType     String      // "BEFORE" | "AFTER"
  room          String?     // "KITCHEN", "BATHROOMS", etc.
  imageUrl      String      // URL da imagem ou base64
  caption       String?
  uploadedAt    DateTime    @default(now())

  @@index([appointmentId])
  @@map("appointment_photos")
}
